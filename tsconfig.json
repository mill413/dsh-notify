{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/index.ts", "src/push.ts"],
  "exclude": ["src/client", "lib", "node_modules"]
}
